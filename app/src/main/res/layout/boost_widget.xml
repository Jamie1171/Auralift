<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:gravity="center_vertical" android:padding="12dp" android:orientation="horizontal">
    <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/app_name" android:textSize="16sp" android:textStyle="bold" android:textColor="#E9F1ED" android:padding="8dp"/>
    <Button android:id="@+id/widget_action" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/open_controls" android:textColor="#0D1214" android:backgroundTint="#8BE2CD"/>
</LinearLayout>
